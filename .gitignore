# Ignore everything by default
*

# Keep git metadata and the ignore file itself
!.git/

# Track README.md
!README.md

# Track home dotfiles
!.zshrc
!.zprofile
!.p10k.zsh
!.vimrc
!.hushlogin

# Track shell/config directories
!.oh-my-zsh/
!.config/
!.config/
!.config/Code/
!.config/Code/User/
!.config/Code/User/extensions.txt
!.config/Code/User/settings.json
!.copilot/
!.copilot/agents/
!.copilot/agents/*
!.copilot/copilot-instructions.md

# Ignore macOS and generated files
.DS_Store
.CFUserTextEncoding
.Trash/
.zcompdump*
.zsh_history
.zsh_sessions/
.viminfo
.vscode/
.cache/
.ssh/

# Ignore large user folders
Desktop/
Documents/
Downloads/
GitHub/
Library/
Movies/
Music/
Pictures/
Public/

# Ignore this .gitignore file itself
.gitignore
